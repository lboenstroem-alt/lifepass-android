# Local development (npx expo start, npx expo run:android).
# Copy to .env, which is git-ignored. The repository is PUBLIC: never commit
# a real secret.
#
# Every build talks to production, as every EAS profile does (there is no
# staging for this app). The three server values below are the public
# production ones eas.json already holds. Keep them set: until F2 and F3 move
# the API and Supabase clients onto src/config/env.ts (which falls back to
# production by itself), the legacy clients need them, and an empty or
# missing value stops the app at launch (src/supabase/lib/client.ts throws;
# src/api/client.ts would call an empty base URL).

# The LifePass API. Always the www host (the apex redirect drops the bearer).
EXPO_PUBLIC_LIFEPASS_API_URL=https://www.lifepass.is/api/v1
# The Supabase project and its publishable key (public by design).
EXPO_PUBLIC_SUPABASE_URL=https://katielfjlyidadfftsnz.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_QmVpB8ckWzz6NCZpKzqGWg_Ngev7KM3

# Optional; leave commented out unless you need them.
#
# Mapbox public runtime token (pk.), restricted to the Android app. Without
# it the Explore map has no tiles.
# EXPO_PUBLIC_MAPBOX_TOKEN=
# YES lets this build offer Continue with Google and Apple (Supabase must
# also have the provider switched on).
# EXPO_PUBLIC_SOCIAL_SIGN_IN=YES
# Debug-only fixture switches, the twin of the iOS -LPScreenshot* arguments,
# e.g. state=active-plan,language=is,tab=4 (see src/dev/fixtures.ts).
# EXPO_PUBLIC_FIXTURE=

# Build time only (Gradle, read by config/fragments/mapbox.js): the Mapbox
# secret download token (sk.). Optional since Mapbox dropped the requirement.
# MAPBOX_DOWNLOAD_TOKEN=
