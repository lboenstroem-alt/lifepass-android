    "@react-navigation/native": "^7.2.4",
    "@react-navigation/native-stack": "^7.15.1",
    "@rnmapbox/maps": "^10.3.5",
    "@supabase/supabase-js": "^2.106.1",
    "@types/react": "~19.1.10",
    "expo": "~54.0.37",
    "expo-auth-session": "~7.0.11",
    "expo-camera": "~17.0.10",
    "expo-crypto": "~15.0.9",
    "expo-dev-client": "~6.0.21",
    "expo-font": "~14.0.12",
    "expo-linear-gradient": "~15.0.8",
